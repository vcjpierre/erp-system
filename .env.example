# ERP System - Environment Variables (Example)
# Canonical target: InsForge Postgres + Upstash Redis - backend/.env is authoritative
# Copy to .env / backend/.env and fill with real values. Never commit real secrets.

# App
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- Database (remote default) ---
# Remote (default): InsForge Postgres. Use the full connection string from InsForge.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Local alternative (docker compose): uncomment to use local postgres instead of remote.
# DATABASE_URL=postgresql://erp_user:erp_password@postgres:5432/erp_db
# Local compose only - unused when using InsForge/Upstash remote
POSTGRES_USER=erp_user
# Local compose only - unused when using InsForge/Upstash remote
POSTGRES_PASSWORD=erp_password
# Local compose only - unused when using InsForge/Upstash remote
POSTGRES_DB=erp_db

# --- Redis (remote default) ---
# Remote (default): Upstash Redis over TLS (rediss scheme).
REDIS_URL=rediss://:PASSWORD@HOST:6379
# Local alternative (docker compose): uncomment to use local redis instead of remote.
# REDIS_URL=redis://redis:6379
# Local compose only - unused when using InsForge/Upstash remote
REDIS_HOST=redis
# Local compose only - unused when using InsForge/Upstash remote
REDIS_PORT=6379

# Auth
JWT_SECRET=change-this-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email (Mailtrap default for local dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@erp.local

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=./storage

