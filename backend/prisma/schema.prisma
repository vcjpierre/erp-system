}

// ──────────────────────────────────────────────
// PRODUCT MODELS
// ──────────────────────────────────────────────

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @db.VarChar(50)
  name          String        @db.VarChar(255)
  description   String?       @db.Text
  category      String?       @db.VarChar(100)
  barcode       String?       @db.VarChar(100)
  image         String?       @db.VarChar(500)
  unit          String        @default("pza") @db.VarChar(20)
  price         Decimal       @db.Decimal(15, 2)
  cost          Decimal       @default(0) @db.Decimal(15, 2)
  costingMethod CostingMethod @default(WEIGHTED_AVERAGE) @map("costing_method")
  trackLot      Boolean       @default(false) @map("track_lot")
  trackSerial   Boolean       @default(false) @map("track_serial")
  trackExpiry   Boolean       @default(false) @map("track_expiry")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  companyId     String        @map("company_id") @db.Uuid
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventories          Inventory[]
  lots                 InventoryLot[]
  serials              InventorySerial[]
  inventoryTransactions InventoryTransaction[]
  adjustmentLines      InventoryAdjustmentLine[]
  physicalCountLines   PhysicalCountLine[]
  valuationLayers      ValuationLayer[]
  pickOrderLines       PickOrderLine[]
  packOrderLines       PackOrderLine[]
  dispatchOrderLines   DispatchOrderLine[]

  @@unique([companyId, code])
  @@unique([companyId, barcode])
  @@map("products")
  @@schema("erp")
}

model Inventory {
  id          String   @id @default(uuid()) @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(15, 4)
  reservedQty Decimal  @default(0) @map("reserved_qty") @db.Decimal(15, 4)
  availableQty Decimal @default(0) @map("available_qty") @db.Decimal(15, 4)
  minStock    Decimal  @default(0) @map("min_stock") @db.Decimal(15, 4)
  maxStock    Decimal  @default(0) @map("max_stock") @db.Decimal(15, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String   @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  String?  @map("location_id") @db.Uuid
  location    WarehouseLocation? @relation(fields: [locationId], references: [id])
  lotId       String?  @map("lot_id") @db.Uuid
  lot         InventoryLot? @relation(fields: [lotId], references: [id])
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId, locationId])
  @@index([productId, lotId])
  @@map("inventories")
  @@schema("erp")
}

model PriceList {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  type      String   @default("SALE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("price_lists")
  @@schema("erp")
}

// ──────────────────────────────────────────────
// AUTOMATION MODELS
// ──────────────────────────────────────────────

model Approval {
  id            String         @id @default(uuid()) @db.Uuid
  entityType    String         @map("entity_type") @db.VarChar(50)
  entityId      String         @map("entity_id") @db.Uuid
  status        ApprovalStatus @default(PENDING)
  comment       String?        @db.Text
  requestedAt   DateTime       @default(now()) @map("requested_at")
  respondedAt   DateTime?      @map("responded_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  companyId     String         @map("company_id") @db.Uuid
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy   String         @map("requested_by") @db.Uuid
  requestedByUser User         @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id])
  approverId    String         @map("approver_id") @db.Uuid
  approver      User           @relation("Approver", fields: [approverId], references: [id])

  @@index([companyId, entityType, entityId])
  @@map("approvals")
  @@schema("erp")
}

model BusinessRule {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(255)
  description String?              @db.Text
  trigger     BusinessRuleTrigger
  condition   String?              @db.Text
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  companyId   String               @map("company_id") @db.Uuid
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actions     BusinessRuleAction[]

  @@map("business_rules")
  @@schema("erp")
}

model BusinessRuleAction {
  id           String       @id @default(uuid()) @db.Uuid
  type         String       @db.VarChar(50)
  config       Json?        @db.JsonB
  order        Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at")
  businessRuleId String     @map("business_rule_id") @db.Uuid
  businessRule BusinessRule @relation(fields: [businessRuleId], references: [id], onDelete: Cascade)

  @@map("business_rule_actions")
  @@schema("erp")
}

// ──────────────────────────────────────────────
// PHASE 4: INVENTORY, WAREHOUSING & TRACEABILITY
// ──────────────────────────────────────────────

model WarehouseLocation {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  barcode   String?  @db.VarChar(100)
  aisle     String?  @db.VarChar(50)
  rack      String?  @db.VarChar(50)
  shelf     String?  @db.VarChar(50)
  bin       String?  @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  warehouseId String         @map("warehouse_id") @db.Uuid
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parentId    String?        @map("parent_id") @db.Uuid
  parent      WarehouseLocation? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    WarehouseLocation[] @relation("LocationHierarchy")
  companyId   String         @map("company_id") @db.Uuid
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventories          Inventory[]
  inventoryTransactions InventoryTransaction[]
  adjustmentLines      InventoryAdjustmentLine[]
  physicalCountLines   PhysicalCountLine[]
  pickOrderLines       PickOrderLine[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
  @@schema("erp")
}

model InventoryLot {
  id          String   @id @default(uuid()) @db.Uuid
  lotNumber   String   @map("lot_number") @db.VarChar(100)
  quantity    Decimal  @default(0) @db.Decimal(15, 4)
  expiryDate  DateTime? @map("expiry_date")
  receivedAt  DateTime @default(now()) @map("received_at")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  productId String    @map("product_id") @db.Uuid
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId String    @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventories          Inventory[]
  inventoryTransactions InventoryTransaction[]
  adjustmentLines      InventoryAdjustmentLine[]
  pickOrderLines       PickOrderLine[]

  @@unique([productId, lotNumber])
  @@index([productId, expiryDate])
  @@map("inventory_lots")
  @@schema("erp")
}

model InventorySerial {
  id           String   @id @default(uuid()) @db.Uuid
  serialNumber String   @map("serial_number") @db.VarChar(100)
  status       String   @default("IN_STOCK") @db.VarChar(20)
  receivedAt   DateTime @default(now()) @map("received_at")
  soldAt       DateTime? @map("sold_at")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([productId, serialNumber])
  @@map("inventory_serials")
  @@schema("erp")
}

model InventoryTransaction {
  id           String       @id @default(uuid()) @db.Uuid
  movementType MovementType @map("movement_type")
  quantity     Decimal      @db.Decimal(15, 4)
  unitCost     Decimal      @default(0) @map("unit_cost") @db.Decimal(15, 2)
  totalCost    Decimal      @default(0) @map("total_cost") @db.Decimal(15, 2)
  reference    String?      @db.VarChar(255)
  referenceId  String?      @map("reference_id") @db.VarChar(100)
  notes        String?      @db.Text
  movedAt      DateTime     @default(now()) @map("moved_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String   @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  String?  @map("location_id") @db.Uuid
  location    WarehouseLocation? @relation(fields: [locationId], references: [id])
  lotId       String?  @map("lot_id") @db.Uuid
  lot         InventoryLot? @relation(fields: [lotId], references: [id])
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([productId, warehouseId, movedAt])
  @@index([referenceId])
  @@index([companyId, movedAt])
  @@map("inventory_transactions")
  @@schema("erp")
}

model TransferOrder {
  id              String         @id @default(uuid()) @db.Uuid
  number          String         @db.VarChar(100)
  description     String?        @db.Text
  status          TransferStatus @default(DRAFT)
  transferredAt   DateTime?      @map("transferred_at")
  receivedAt      DateTime?      @map("received_at")
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  companyId     String    @map("company_id") @db.Uuid
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouseId String  @map("from_warehouse_id") @db.Uuid
  fromWarehouse  Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId  String   @map("to_warehouse_id") @db.Uuid
  toWarehouse    Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  createdById    String    @map("created_by_id") @db.Uuid
  createdBy      User      @relation("TransferOrderCreator", fields: [createdById], references: [id])

  lines TransferOrderLine[]

  @@unique([companyId, number])
  @@map("transfer_orders")
  @@schema("erp")
}

model TransferOrderLine {
  id          String   @id @default(uuid()) @db.Uuid
  lineNumber  Int      @map("line_number")
  description String?  @db.Text
  quantity    Decimal  @db.Decimal(15, 4)
  transferredQty Decimal @default(0) @map("transferred_qty") @db.Decimal(15, 4)
  receivedQty Decimal  @default(0) @map("received_qty") @db.Decimal(15, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  transferOrderId String        @map("transfer_order_id") @db.Uuid
  transferOrder   TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  companyId       String        @map("company_id") @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("transfer_order_lines")
  @@schema("erp")
}

model InventoryAdjustment {
  id          String                   @id @default(uuid()) @db.Uuid
  number      String                   @db.VarChar(100)
  description String                   @db.Text
  type        InventoryAdjustmentType
  reason      String                   @db.VarChar(255)
  status      String                   @default("DRAFT") @db.VarChar(20)
  postedAt    DateTime?                @map("posted_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  companyId  String                   @map("company_id") @db.Uuid
  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String                  @map("created_by_id") @db.Uuid
  createdBy   User                    @relation(fields: [createdById], references: [id])

  lines InventoryAdjustmentLine[]

  @@unique([companyId, number])
  @@map("inventory_adjustments")
  @@schema("erp")
}

model InventoryAdjustmentLine {
  id          String   @id @default(uuid()) @db.Uuid
  lineNumber  Int      @map("line_number")
  description String?  @db.Text
  quantity    Decimal  @db.Decimal(15, 4)
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(15, 2)
  totalCost   Decimal  @default(0) @map("total_cost") @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  adjustmentId String               @map("adjustment_id") @db.Uuid
  adjustment   InventoryAdjustment  @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String               @map("product_id") @db.Uuid
  product      Product              @relation(fields: [productId], references: [id])
  warehouseId  String               @map("warehouse_id") @db.Uuid
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id])
  locationId   String?              @map("location_id") @db.Uuid
  location     WarehouseLocation?   @relation(fields: [locationId], references: [id])
  lotId        String?              @map("lot_id") @db.Uuid
  lot          InventoryLot?        @relation(fields: [lotId], references: [id])
  companyId    String               @map("company_id") @db.Uuid
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("inventory_adjustment_lines")
  @@schema("erp")
}

model PhysicalCount {
  id          String              @id @default(uuid()) @db.Uuid
  number      String              @db.VarChar(100)
  description String?             @db.Text
  status      PhysicalCountStatus @default(DRAFT)
  countDate   DateTime            @default(now()) @map("count_date")
  approvedAt  DateTime?           @map("approved_at")
  notes       String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  companyId   String    @map("company_id") @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation(fields: [createdById], references: [id])

  lines PhysicalCountLine[]

  @@unique([companyId, number])
  @@map("physical_counts")
  @@schema("erp")
}

model PhysicalCountLine {
  id           String   @id @default(uuid()) @db.Uuid
  lineNumber   Int      @map("line_number")
  expectedQty  Decimal  @default(0) @map("expected_qty") @db.Decimal(15, 4)
  countedQty   Decimal  @default(0) @map("counted_qty") @db.Decimal(15, 4)
  differenceQty Decimal @default(0) @map("difference_qty") @db.Decimal(15, 4)
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  physicalCountId String        @map("physical_count_id") @db.Uuid
  physicalCount   PhysicalCount @relation(fields: [physicalCountId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id])
  locationId      String?       @map("location_id") @db.Uuid
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])
  companyId       String        @map("company_id") @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("physical_count_lines")
  @@schema("erp")
}

model ValuationLayer {
  id           String  @id @default(uuid()) @db.Uuid
  quantity     Decimal @db.Decimal(15, 4)
  unitCost     Decimal @map("unit_cost") @db.Decimal(15, 2)
  totalCost    Decimal @map("total_cost") @db.Decimal(15, 2)
  remainingQty Decimal @default(0) @map("remaining_qty") @db.Decimal(15, 4)
  layerDate    DateTime @default(now()) @map("layer_date")
  layerType    String  @default("PURCHASE") @map("layer_type") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String   @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([productId, warehouseId, layerDate])
  @@index([remainingQty])
  @@map("valuation_layers")
  @@schema("erp")
}

// ──────────────────────────────────────────────
// PHASE 4: PICKING, PACKING & DISPATCH
// ──────────────────────────────────────────────

model PickOrder {
  id            String     @id @default(uuid()) @db.Uuid
  number        String     @db.VarChar(100)
  description   String?    @db.Text
  status        PickStatus @default(PENDING)
  priority      String     @default("NORMAL") @db.VarChar(20)
  pickedAt      DateTime?  @map("picked_at")
  notes         String?    @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  companyId    String    @map("company_id") @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId  String    @map("warehouse_id") @db.Uuid
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  assignedTo   String?   @map("assigned_to") @db.Uuid
  assignedUser User?     @relation("PickOrderAssignee", fields: [assignedTo], references: [id])
  createdById  String    @map("created_by_id") @db.Uuid
  createdBy    User      @relation("PickOrderCreator", fields: [createdById], references: [id])

  lines    PickOrderLine[]
  packOrders PackOrder[]

  @@unique([companyId, number])
  @@map("pick_orders")
  @@schema("erp")
}

model PickOrderLine {
  id          String   @id @default(uuid()) @db.Uuid
  lineNumber  Int      @map("line_number")
  description String?  @db.Text
  quantity    Decimal  @db.Decimal(15, 4)
  pickedQty   Decimal  @default(0) @map("picked_qty") @db.Decimal(15, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  pickOrderId String    @map("pick_order_id") @db.Uuid
  pickOrder   PickOrder @relation(fields: [pickOrderId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id])
  locationId  String?   @map("location_id") @db.Uuid
  location    WarehouseLocation? @relation(fields: [locationId], references: [id])
  lotId       String?   @map("lot_id") @db.Uuid
  lot         InventoryLot? @relation(fields: [lotId], references: [id])
  companyId   String    @map("company_id") @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("pick_order_lines")
  @@schema("erp")
}

model PackOrder {
  id          String     @id @default(uuid()) @db.Uuid
  number      String     @db.VarChar(100)
  description String?    @db.Text
  status      PackStatus @default(PENDING)
  packedAt    DateTime?  @map("packed_at")
  notes       String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  companyId    String    @map("company_id") @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pickOrderId  String?   @map("pick_order_id") @db.Uuid
  pickOrder    PickOrder? @relation(fields: [pickOrderId], references: [id])
  createdById  String    @map("created_by_id") @db.Uuid
  createdBy    User      @relation(fields: [createdById], references: [id])

  lines    PackOrderLine[]
  dispatchOrders DispatchOrder[]

  @@unique([companyId, number])
  @@map("pack_orders")
  @@schema("erp")
}

model PackOrderLine {
  id          String   @id @default(uuid()) @db.Uuid
  lineNumber  Int      @map("line_number")
  description String?  @db.Text
  quantity    Decimal  @db.Decimal(15, 4)
  packedQty   Decimal  @default(0) @map("packed_qty") @db.Decimal(15, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  packOrderId String    @map("pack_order_id") @db.Uuid
  packOrder   PackOrder @relation(fields: [packOrderId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id])
  companyId   String    @map("company_id") @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("pack_order_lines")
  @@schema("erp")
}

model DispatchOrder {
  id            String         @id @default(uuid()) @db.Uuid
  number        String         @db.VarChar(100)
  description   String?        @db.Text
  status        DispatchStatus @default(PENDING)
  dispatchedAt  DateTime?      @map("dispatched_at")
  deliveredAt   DateTime?      @map("delivered_at")
  recipientName String?        @map("recipient_name") @db.VarChar(255)
  deliveryAddress String?      @map("delivery_address") @db.Text
  trackingNumber String?        @map("tracking_number") @db.VarChar(100)
  carrier       String?        @db.VarChar(100)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  companyId    String    @map("company_id") @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  packOrderId  String?   @map("pack_order_id") @db.Uuid
  packOrder    PackOrder? @relation(fields: [packOrderId], references: [id])
  createdById  String    @map("created_by_id") @db.Uuid
  createdBy    User      @relation(fields: [createdById], references: [id])

  lines DispatchOrderLine[]

  @@unique([companyId, number])
  @@map("dispatch_orders")
  @@schema("erp")
}

model DispatchOrderLine {
  id          String   @id @default(uuid()) @db.Uuid
  lineNumber  Int      @map("line_number")
  description String?  @db.Text
  quantity    Decimal  @db.Decimal(15, 4)
  dispatchedQty Decimal @default(0) @map("dispatched_qty") @db.Decimal(15, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  dispatchOrderId String         @map("dispatch_order_id") @db.Uuid
  dispatchOrder   DispatchOrder  @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  productId       String         @map("product_id") @db.Uuid
  product         Product        @relation(fields: [productId], references: [id])
  companyId       String         @map("company_id") @db.Uuid
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("dispatch_order_lines")
  @@schema("erp")
}

// ──────────────────────────────────────────────
// ECOMMERCE SYNC
// ──────────────────────────────────────────────

model EcommerceSync {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.VarChar(100)
  action      String   @db.VarChar(50)
  status      String   @default("PENDING") @db.VarChar(20)
  error       String?  @db.Text
  syncedAt    DateTime? @map("synced_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, status])
  @@map("ecommerce_syncs")
  @@schema("erp")
}
