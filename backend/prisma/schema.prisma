  description     String          @db.Text
  quantity        Decimal         @db.Decimal(15, 4)
  estimatedPrice  Decimal?        @map("estimated_price") @db.Decimal(15, 2)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  purchaseRequestId String        @map("purchase_request_id") @db.Uuid
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  companyId       String          @map("company_id") @db.Uuid
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("purchase_request_lines")
  @@schema("erp")
}

model PurchaseOrder {
  id             String               @id @default(uuid()) @db.Uuid
  number         String               @db.VarChar(100)
  issueDate      DateTime             @map("issue_date")
  expectedDate   DateTime?            @map("expected_date")
  subtotal       Decimal              @db.Decimal(15, 2)
  taxTotal       Decimal              @default(0) @map("tax_total") @db.Decimal(15, 2)
  total          Decimal              @db.Decimal(15, 2)
  status         PurchaseOrderStatus  @default(DRAFT)
  notes          String?              @db.Text
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  companyId      String               @map("company_id") @db.Uuid
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId     String               @map("supplier_id") @db.Uuid
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  purchaseRequestId String?           @map("purchase_request_id") @db.Uuid
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  lines          PurchaseOrderLine[]
  receivings     Receiving[]
  importCosts    ImportCost[]

  @@unique([companyId, number])
  @@map("purchase_orders")
  @@schema("erp")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  lineNumber      Int           @map("line_number")
  description     String        @db.Text
  quantity        Decimal       @db.Decimal(15, 4)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(15, 4)
  subtotal        Decimal       @db.Decimal(15, 2)
  receivedQty     Decimal       @default(0) @map("received_qty") @db.Decimal(15, 4)
  createdAt       DateTime      @default(now()) @map("created_at")
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  companyId       String        @map("company_id") @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
  @@schema("erp")
}

model Receiving {
  id             String          @id @default(uuid()) @db.Uuid
  number         String          @db.VarChar(100)
  receivedDate   DateTime        @map("received_date")
  status         ReceivingStatus @default(PENDING)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  companyId      String          @map("company_id") @db.Uuid
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrderId String         @map("purchase_order_id") @db.Uuid
  purchaseOrder  PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  lines          ReceivingLine[]

  @@unique([companyId, number])
  @@map("receivings")
  @@schema("erp")
}

model ReceivingLine {
  id          String        @id @default(uuid()) @db.Uuid
  lineNumber  Int           @map("line_number")
  description String        @db.Text
  quantity    Decimal       @db.Decimal(15, 4)
  createdAt   DateTime      @default(now()) @map("created_at")
  receivingId String        @map("receiving_id") @db.Uuid
  receiving   Receiving     @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  companyId   String        @map("company_id") @db.Uuid
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("receiving_lines")
  @@schema("erp")
}

model ImportCost {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(15, 2)
  currency    String   @default("MXN") @db.VarChar(3)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@map("import_costs")
  @@schema("erp")
}

model SupplierPriceHistory {
  id          String   @id @default(uuid()) @db.Uuid
  description String   @db.Text
  price       Decimal  @db.Decimal(15, 2)
  date        DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId  String   @map("supplier_id") @db.Uuid
